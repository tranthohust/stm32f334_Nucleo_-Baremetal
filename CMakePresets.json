{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "stm32-base",
      "hidden": true,
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "debug",
      "displayName": "STM32F334 Debug",
      "inherits": "stm32-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FIRMWARE_USE_FREERTOS": false
      }
    },
    {
      "name": "release",
      "displayName": "STM32F334 Release",
      "inherits": "stm32-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FIRMWARE_USE_FREERTOS": false
      }
    },
    {
      "name": "rtos-debug",
      "displayName": "STM32F334 FreeRTOS Debug",
      "inherits": "debug",
      "cacheVariables": {
        "FIRMWARE_USE_FREERTOS": true
      }
    },
    {
      "name": "rtos-release",
      "displayName": "STM32F334 FreeRTOS Release",
      "inherits": "release",
      "cacheVariables": {
        "FIRMWARE_USE_FREERTOS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "rtos-debug",
      "configurePreset": "rtos-debug"
    },
    {
      "name": "rtos-release",
      "configurePreset": "rtos-release"
    }
  ]
}
